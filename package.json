{
  "name": "owllfloor",
  "version": "0.2.0",
  "description": "OwllFloor — an AI dev team you can watch working",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Felipe Brito",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "watch": "tsx src/cli/watch.ts",
    "simulate": "tsx scripts/simulate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ws": "^8.22.2"
  }
}
